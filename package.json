{
  "name": "code-terminal-kernel",
  "publisher": "leoustc",
  "author": "leoustc",
  "displayName": "Terminal Kernel",
  "description": "Create, reuse, and manage persistent terminals from VS Code.",
  "icon": "media/terminal.png",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/leoustc/code-terminal-kernel.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "categories": [
    "Other"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "persistentTerminals",
          "title": "Terminal Kernel",
          "icon": "media/terminal.svg"
        }
      ]
    },
    "views": {
      "persistentTerminals": [
        {
          "id": "terminalKernelSessions",
          "name": "Terminal Kernel"
        }
      ]
    },
    "commands": [
      {
        "command": "terminalKernel.newSession",
        "title": "New Terminal",
        "icon": "$(add)"
      },
      {
        "command": "terminalKernel.connectSession",
        "title": "Connect to Terminal"
      },
      {
        "command": "terminalKernel.connectRemote",
        "title": "Connect via SSH"
      },
      {
        "command": "terminalKernel.addFavorite",
        "title": "Favorite",
        "icon": "$(star)"
      },
      {
        "command": "terminalKernel.removeFavorite",
        "title": "Unfavorite",
        "icon": "$(star-full)"
      },
      {
        "command": "terminalKernel.showSession",
        "title": "Clear",
        "icon": "$(clear-all)"
      },
      {
        "command": "terminalKernel.deleteSession",
        "title": "Delete",
        "icon": "$(close)"
      },
      {
        "command": "terminalKernel.setFilter",
        "title": "Filter Sessions",
        "icon": "$(filter)"
      },
      {
        "command": "terminalKernel.clearFilter",
        "title": "Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "terminalKernel.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "terminalKernel.openSettings",
        "title": "Terminal Kernel Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "terminalKernel.refresh",
          "when": "view == terminalKernelSessions",
          "group": "navigation@1"
        },
        {
          "command": "terminalKernel.setFilter",
          "when": "view == terminalKernelSessions && !terminalKernel.filterActive",
          "group": "navigation@2"
        },
        {
          "command": "terminalKernel.clearFilter",
          "when": "view == terminalKernelSessions && terminalKernel.filterActive",
          "group": "navigation@2"
        },
        {
          "command": "terminalKernel.openSettings",
          "when": "view == terminalKernelSessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "terminalKernel.newSession",
          "when": "view == terminalKernelSessions && viewItem == terminalGroup",
          "group": "inline@1"
        },
        {
          "command": "terminalKernel.connectSession",
          "when": "view == terminalKernelSessions && (viewItem == terminalSession || viewItem == terminalSessionFavorite)",
          "group": "context@1"
        },
        {
          "command": "terminalKernel.addFavorite",
          "when": "view == terminalKernelSessions && viewItem == terminalSession",
          "group": "inline@1"
        },
        {
          "command": "terminalKernel.removeFavorite",
          "when": "view == terminalKernelSessions && viewItem == terminalSessionFavorite",
          "group": "inline@1"
        },
        {
          "command": "terminalKernel.showSession",
          "when": "view == terminalKernelSessions && (viewItem == terminalSession || viewItem == terminalSessionFavorite)",
          "group": "inline@2"
        },
        {
          "command": "terminalKernel.deleteSession",
          "when": "view == terminalKernelSessions && (viewItem == terminalSession || viewItem == terminalSessionFavorite)",
          "group": "inline@6"
        }
      ]
    },
    "configuration": {
      "title": "Terminal Kernel",
      "properties": {
        "terminalKernel.backend": {
          "type": "string",
          "default": "tmux",
          "enum": [
            "tmux",
            "screen"
          ],
          "description": "Backend used for terminal sessions."
        },
        "terminalKernel.tmuxMouse": {
          "type": "boolean",
          "default": false,
          "description": "Enable tmux mouse mode. When on, tmux captures selection and can interfere with VS Code text selection."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npx tsc -p ./",
    "compile": "npx tsc -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "npx tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3",
    "vsce": "^1.97.0"
  }
}
